PORT=5000
JWT_SECRET=change-me

DB_HOST=localhost
DB_PORT=3306
DB_NAME=library_dev
DB_USER=root
DB_PASSWORD=

# Set DB_SSL=true for hosted MySQL (e.g. TiDB Cloud). DB_CA is only needed for a private CA (use \n for newlines).
